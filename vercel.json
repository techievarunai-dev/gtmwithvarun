{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/projects/us-insurance-outbound/",
      "destination": "/projects/us-insurance-outbound-system/",
      "permanent": true
    },
    {
      "source": "/projects/us-insurance-outbound",
      "destination": "/projects/us-insurance-outbound-system/",
      "permanent": true
    },
    {
      "source": "/projects/ai-candidate-screening/",
      "destination": "/projects/candidate-screening/",
      "permanent": true
    },
    {
      "source": "/projects/ai-candidate-screening",
      "destination": "/projects/candidate-screening/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|svg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)\\.(mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(sitemap\\.xml|robots\\.txt|llms\\.txt|llms-full\\.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*)\\.(html|json|xml|txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=0, must-revalidate"
        }
      ]
    }
  ]
}
